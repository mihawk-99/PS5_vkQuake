 #include <pthread.h>
 #include <sched.h>
 #include <stdio.h>
@@ -235,6 +236,94 @@ static void test_semaphore(void)
     printf("  semaphore: wait, try-wait, post and value agree\n");
 }
 
+/* Many threads through one semaphore: every unit posted is taken exactly once
+ * and no waiter sleeps through a post. A lost wakeup hangs here, which the
+ * harness's timeout turns into a failure. A try-waiting thread competes the way
+ * vkQuake's task queue spins before it waits. */
+enum
+{
+    STRESS_THREADS = 4,
+    STRESS_UNITS = 100000
+};
+static SDL_sem *stress_sem;
+static _Atomic int stress_taken;
+static _Atomic int stress_done;
+static void *stress_producer(void *arg)
+{
+    (void)arg;
+    for (int i = 0; i < STRESS_UNITS; ++i)
+        SDL_SemPost(stress_sem);
+    return NULL;
+}
+static void *stress_consumer(void *arg)
+{
+    (void)arg;
+    for (int i = 0; i < STRESS_UNITS; ++i)
+    {
+        SDL_SemWait(stress_sem);
+        atomic_fetch_add(&stress_taken, 1);
+    }
+    return NULL;
+}
+static void *stress_sleeper(void *arg)
+{
+    (void)arg;
+    for (int i = 0; i < 100; ++i)
+    {
+        SDL_SemWait(stress_sem);
+        atomic_fetch_add(&stress_taken, 1);
+    }
+    return NULL;
+}
+static void *stress_trier(void *arg)
+{
+    (void)arg;
+    while (!atomic_load(&stress_done))
+        if (SDL_SemTryWait(stress_sem) == 0)
+            SDL_SemPost(stress_sem); /* give it back: only the consumers keep units */
+    return NULL;
+}
+static void test_semaphore_stress(void)
+{
+    stress_sem = SDL_CreateSemaphore(0);
+    assert(stress_sem != NULL);
+    pthread_t producers[STRESS_THREADS], consumers[STRESS_THREADS], trier;
+    pthread_create(&trier, NULL, stress_trier, NULL);
+    for (int t = 0; t < STRESS_THREADS; ++t)
+    {
+        pthread_create(&consumers[t], NULL, stress_consumer, NULL);
+        pthread_create(&producers[t], NULL, stress_producer, NULL);
+    }
+    for (int t = 0; t < STRESS_THREADS; ++t)
+    {
+        pthread_join(producers[t], NULL);
+        pthread_join(consumers[t], NULL);
+    }
+    atomic_store(&stress_done, 1);
+    pthread_join(trier, NULL);
+    assert(atomic_load(&stress_taken) == STRESS_THREADS * STRESS_UNITS);
+    assert(SDL_SemValue(stress_sem) == 0);
+
+    /* Units that arrive slower than a wait spins, so the waiters really sleep and
+     * only a post's wake can get them out: 200 posts 500 us apart to two waiters. */
+    atomic_store(&stress_taken, 0);
+    pthread_t sleepers[2];
+    for (int t = 0; t < 2; ++t)
+        pthread_create(&sleepers[t], NULL, stress_sleeper, NULL);
+    for (int i = 0; i < 200; ++i)
+    {
+        usleep(500);
+        SDL_SemPost(stress_sem);
+    }
+    for (int t = 0; t < 2; ++t)
+        pthread_join(sleepers[t], NULL);
+    assert(atomic_load(&stress_taken) == 200);
+    SDL_DestroySemaphore(stress_sem);
+    printf("  semaphore: %d units through %d producers, %d consumers and a try-waiter, and 200 "
+           "slow posts to sleeping waiters, none lost\n",
+           STRESS_THREADS * STRESS_UNITS, STRESS_THREADS, STRESS_THREADS);
+}
+
