@@ -360,6 +449,7 @@ int main(void)
     test_cond_signalled_and_timeout();
     test_thread_lifecycle();
     test_semaphore();
+    test_semaphore_stress();
     test_delay_and_clock();
     test_error_is_per_thread();
     test_filesystem_answers();
